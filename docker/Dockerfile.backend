FROM node:20-alpine
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
COPY backend/package*.json ./
COPY backend/prisma ./prisma/
RUN npm install
COPY backend/ ./
RUN npx prisma generate

ENV PORT=5000
EXPOSE 5000
CMD ["sh", "-c", "until npx prisma db push; do echo 'Waiting for MySQL database to be ready...'; sleep 3; done && sleep 2 && npx ts-node src/seed.ts && npx ts-node src/server.ts"]
